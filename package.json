    "@sparticuz/chromium": "153.0.0",
    "@vercel/functions": "^3.9.11",
    "connect-timeout": "^1.9.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.3.2",
    "helmet": "^8.2.0",
    "html-entities": "^2.6.0",
    "linkedom": "0.18.12",
    "node-cache": "^5.1.2",
    "puppeteer-core": "25.12.0",
    "swagger-ui-express": "^5.0.1",
    "undici": "^7.30.0",
    "yamljs": "^0.3.0"
