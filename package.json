    "test:integration": "npm test -- tests/integration",
    "check:browser": "node scripts/check-dorar-browser.js"
  },
  "keywords": [
    "hadith",
    "api",
    "sunnah"
  ],
  "author": "\u0623\u062d\u0645\u062f \u0627\u0644\u0637\u0628\u0631\u0627\u0646\u064a (Ahmed El-Tabarani)",
