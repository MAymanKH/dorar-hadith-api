--- /dev/null
+++ b/scripts/prepare-chromium.js
@@ -0,0 +1,16 @@
+const { mkdirSync, writeFileSync, chmodSync } = require('node:fs');
+const { resolve } = require('node:path');
+const directory = resolve('build/chromium');
+mkdirSync(directory, { recursive: true });
+mkdirSync('public', { recursive: true });
+writeFileSync('public/build-marker.txt', 'Dorar API\n');
+process.env.TMPDIR = directory;
+(async () => {
+  const { default: chromium } = await import('@sparticuz/chromium');
+  const executable = await chromium.executablePath();
+  chmodSync(executable, 0o755);
+  console.log(`Prepared Chromium at ${executable}`);
+})().catch((error) => {
+  console.error(error);
+  process.exitCode = 1;
+});
