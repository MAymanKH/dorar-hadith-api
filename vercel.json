{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "installCommand": "npm ci",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{node_modules/@sparticuz/chromium/bin/**,api-docs/**,data/**}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
